# ---------------------------------------------------------------------------
# Nexus Clips — Vercel app
# ---------------------------------------------------------------------------

# Public URL of this deployment (used for OAuth redirects).
APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic -------------------------------------------------------------
# Writes the description hooks (claude-opus-5).
ANTHROPIC_API_KEY=

# --- YouTube Data API v3 ---------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). The redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# --- Worker service --------------------------------------------------------
# The container running ffmpeg, yt-dlp and Whisper. See worker/README.md.
WORKER_URL=https://your-worker.up.railway.app
WORKER_SHARED_SECRET=

# --- Cron ------------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on cron requests.
CRON_SECRET=

# Reported on the Settings page as a configured/not-configured indicator; the
# key itself is only used by the worker.
OPENAI_API_KEY=
