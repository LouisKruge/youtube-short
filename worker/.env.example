# ---------------------------------------------------------------------------
# Nexus Clips — worker service
# ---------------------------------------------------------------------------

PORT=8080

# Must match WORKER_SHARED_SECRET in the Vercel app.
WORKER_SHARED_SECRET=

# --- Supabase --------------------------------------------------------------
# Same project as the app. The worker writes results directly.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=nexus-media

# --- Model providers -------------------------------------------------------
# Whisper transcription (word-level timestamps).
OPENAI_API_KEY=
# Hook generation (claude-opus-5).
ANTHROPIC_API_KEY=

# --- YouTube ---------------------------------------------------------------
# The same OAuth client the app uses. The worker performs the uploads, so it
# needs the client credentials to refresh the stored token. It never runs the
# authorization redirect — the app does that and stores the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/youtube/callback

# --- Tuning ----------------------------------------------------------------
# Scratch space for downloads and renders. Must be writable and have room for
# the largest source video you expect.
MEDIA_DIR=/tmp/nexus-media

# Self-poll interval; the app also nudges the worker directly.
POLL_INTERVAL_MS=60000

# Attempts before a job is parked as failed.
MAX_ATTEMPTS=3

# A claim older than this is treated as a crashed worker and reclaimed.
CLAIM_TIMEOUT_MS=1800000

# Seconds between loudness samples. Smaller = finer peak detection, slower
# analysis, larger envelope.
ANALYSIS_HOP_SECONDS=0.5

# Render karaoke AND static up front instead of on selection.
#   false (default) — one encode per clip; operator waits ~20s after choosing.
#   true            — no wait on selection; ~2x CPU and storage, half wasted
#                     on clips that never get approved.
RENDER_BOTH_CAPTION_STYLES=false

# Set false to skip Whisper entirely (clips ship without captions).
TRANSCRIPTION_ENABLED=true
